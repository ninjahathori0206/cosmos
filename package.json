{
  "name": "cosmos-erp",
  "version": "1.0.0",
  "description": "Cosmos ERP — Command Unit + Foundry · Node.js + MSSQL · Stored Procedures · REST API · IIS + PM2",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate:passwords": "node scripts/migrate-passwords.js",
    "migrate:38-offer-trigger-target": "node scripts/run-migration-38-offer-trigger-target.js",
    "migrate:40-invoice-json": "node scripts/run-migration-40-invoice-display-json.js",
    "migrate:41-sub-order-pairs": "node scripts/run-migration-41-sub-order-pairs.js",
    "migrate:45-users-password-hash": "node scripts/run-migration-45-users-password-hash.js",
    "migrate:46-foundry-primary-warehouse-functions": "node scripts/run-migration-46-foundry-primary-warehouse-functions.js",
    "maintenance:migrate-store-in-charge-role": "node scripts/run-maintenance-migrate-store-in-charge-role.js",
    "maintenance:purge-keep-user": "node scripts/run-maintenance-purge-keep-user.js",
    "deploy:auth-users-sp": "node scripts/deploy-auth-users-sp.js",
    "migrate:pos-checkout-inventory-drafts": "node scripts/run-migration-pos-checkout-inventory-drafts.js",
    "verify:api-modules": "node -e \"require('./src/api/orders');require('./src/api/pos');require('./src/services/orderService');console.log('api modules ok')\"",
    "deploy:pos-sql": "node scripts/deploy_pos_sql.js",
    "publish:design-local": "node -e \"require('fs').copyFileSync('pencil-new.pen','src/public/design/pencil-local/pencil-new.pen'); console.log('Copied pencil-new.pen → src/public/design/pencil-local/')\"",
    "merge:pen": "node scripts/merge-pen-into-primary.js",
    "sql:tables": "node scripts/run-sql.js"
