NODE_ENV=development
PORT=4000

# CORS — comma-separated full origins (scheme + host [+ port]); trailing slashes optional; prod must list every SPA/static site that calls this API.
ALLOWED_ORIGINS=http://localhost:4000
# Store OS / Store Pilot PWA on a device over HTTPS (ngrok): after `npm run tunnel:storeos` or `npm run tunnel:storepilot`, append the forwarding URL exactly:
# ALLOWED_ORIGINS=http://localhost:4000,https://YOUR_SUBDOMAIN.ngrok-free.app
# Production / emailed links: set to the public origin users open in the browser.
# APP_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app
# Development: also allow private LAN origins (192.168.x.x, 10.x.x.x, 172.16–31.x.x) unless set to false
# Set false if your dev PC is on untrusted Wi‑Fi. Production never uses this flag.
# CORS_ALLOW_PRIVATE_LAN=true



DB_HOST=localhost
DB_PORT=1433
DB_NAME=CosmosERP
DB_USER=cosmos_app
DB_PASSWORD=CHANGE_ME

# Optional pool / timeouts (defaults shown in src/config/db.js)
# DB_CONNECTION_TIMEOUT_MS=15000
# DB_REQUEST_TIMEOUT_MS=30000
# DB_POOL_MIN=2
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_ACQUIRE_TIMEOUT_MS=15000
# DB_CONNECT_RETRIES=3
# DB_CONNECT_BACKOFF_MS=500

# Auth — required for /api/auth/login and JWT issuance
# JWT_SECRET: non-empty; server exits at startup if missing or invalid with JWT_EXPIRES_IN
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRES_IN=1d

# Store OS tablet device JWT (X-Tablet-Token) — long-lived; revoke via Tablet Management (deactivate / PIN reset). Default 365d.
# POS_TABLET_JWT_EXPIRES=365d

# Eyewoot Go customer JWT — separate secret from staff JWT, 90-day expiry
CUSTOMER_JWT_SECRET=CHANGE_ME_CUSTOMER_JWT_SECRET

# Eyewoot Go base URL — used for invite links sent to family members
APP_BASE_URL=http://localhost:4000

# API_KEY: required for all /api/* routes except /config/bootstrap.json, /health*, /api/pos (public parts), /api/qr
# The login page loads this value from GET /config/bootstrap.json (same origin) — keep this in sync with nothing else.
API_KEY=CHANGE_ME_API_KEY

# RBAC — strict empty / missing scoped permissions is default ON (CX, StorePilot lab API, Foundry cross-store lab list, goods-transfer picker).
# Restore legacy “module-only implies access” behaviour only if needed:
# RBAC_LEGACY_EMPTY_PERMISSION_BYPASS=true
# (alias) RBAC_STRICT_EMPTY_PERMISSIONS=false

# API rate limiting (Redis-backed when REDIS_URL or RATE_LIMIT_REDIS_URL is set)
# Must be >= 1 — empty or 0 falls back to 1000 and logs a warning at startup.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
# REDIS_URL=redis://localhost:6379
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Optional AES-256-CBC encryption (32-byte key, 16-byte IV derived internally)
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY_32_BYTES

# Logging
LOG_DIRECTORY=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=50m
LOG_LEVEL=info

# --- Graphiti MCP (optional; separate from Cosmos) ---
# Cosmos listens on PORT above (e.g. 4000). Graphiti uses its own ports (MCP 8000, FalkorDB 6379, UI 3000).
# Clone repo (sibling to cosmos): git clone https://github.com/getzep/graphiti.git
# Configure keys: copy graphiti/mcp_server/.env.example -> graphiti/mcp_server/.env
# Start stack: pwsh ./scripts/graphiti/start-graphiti-docker.ps1   (or start-graphiti-uv.ps1 with uv)
# Cursor MCP URL: http://localhost:8000/mcp/  (see .cursor/mcp.json)
# Optional: set GRAPHITI_REPO if the clone is not ..\graphiti relative to the Curser folder
